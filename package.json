{
  "name": "soundcheck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A live performance companion for bands.",
  "scripts": {
    "dev": "vite",
    "build": "npm run content:check && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "content:check": "tsx scripts/check-content.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "icons": "tsx scripts/make-icons.ts"
  },
  "dependencies": {
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tonal": "^6.4.3"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
